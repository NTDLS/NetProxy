<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0-windows</TargetFramework>
		<Nullable>enable</Nullable>
		<UseWindowsForms>true</UseWindowsForms>
		<ImplicitUsings>enable</ImplicitUsings>
		<ApplicationIcon>AppIcon.ico</ApplicationIcon>

		<Copyright>Copyright © 2026 NetworkDLS</Copyright>
		<Version>3.0.0</Version>
		<Company>NetworkDLS</Company>
		<Product>NetProxy</Product>
	</PropertyGroup>

	<ItemGroup>
		<Content Include="AppIcon.ico" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="NTDLS.Localization" Version="1.0.2" />
		<PackageReference Include="NTDLS.Persistence" Version="2.0.1" />
		<PackageReference Include="NTDLS.WinFormsHelpers" Version="1.6.3" />
		<PackageReference Include="WinForms.DataVisualization" Version="1.10.2" />
	</ItemGroup>

	<ItemGroup>
		<None Include="Translations\Translations.db" Condition="Exists('Translations\Translations.db')" CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>

	<ItemGroup>
		<Using Include="NTDLS.Localization.StaticLocalizer" Static="true" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\NetProxy.Library\NetProxy.Library.csproj" />
		<ProjectReference Include="..\NetProxy.ClientApi\NetProxy.ClientApi.csproj" />
	</ItemGroup>

	<ItemGroup>
		<Compile Update="Properties\Resources.Designer.cs">
			<DesignTime>True</DesignTime>
			<AutoGen>True</AutoGen>
			<DependentUpon>Resources.resx</DependentUpon>
		</Compile>
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Update="Properties\Resources.resx">
			<Generator>ResXFileCodeGenerator</Generator>
			<LastGenOutput>Resources.Designer.cs</LastGenOutput>
		</EmbeddedResource>
	</ItemGroup>

</Project>
