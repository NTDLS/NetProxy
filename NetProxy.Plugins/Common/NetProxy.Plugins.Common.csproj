<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<Description>The code that the NetProxy plug-ins share: HTTP/1.x readers, address ranges, trusted proxies and a settings reader.</Description>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\NetProxy.PluginApi\NetProxy.PluginApi.csproj">
			<Private>false</Private>
			<ExcludeAssets>runtime</ExcludeAssets>
		</ProjectReference>
	</ItemGroup>

	<!-- Its types are internal: only the plug-ins that are built with it, and the tests, can use them. -->
	<ItemGroup>
		<InternalsVisibleTo Include="NetProxy.Plugins.Tests" />
		<InternalsVisibleTo Include="NetProxy.Plugins.AccessLog" />
		<InternalsVisibleTo Include="NetProxy.Plugins.Alerts" />
		<InternalsVisibleTo Include="NetProxy.Plugins.AntiHammer" />
		<InternalsVisibleTo Include="NetProxy.Plugins.BasicAuth" />
		<InternalsVisibleTo Include="NetProxy.Plugins.Cache" />
		<InternalsVisibleTo Include="NetProxy.Plugins.GeoFilter" />
		<InternalsVisibleTo Include="NetProxy.Plugins.Maintenance" />
		<InternalsVisibleTo Include="NetProxy.Plugins.Metrics" />
		<InternalsVisibleTo Include="NetProxy.Plugins.Redirect" />
		<InternalsVisibleTo Include="NetProxy.Plugins.SecurityHeaders" />
		<InternalsVisibleTo Include="NetProxy.Plugins.TrafficSplit" />
	</ItemGroup>

</Project>
