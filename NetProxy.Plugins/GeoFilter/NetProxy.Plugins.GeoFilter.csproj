<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<Description>Allows or denies clients by country and network (MaxMind .mmdb databases, or Cloudflare's CF-IPCountry header).</Description>

		<!-- The plug-in is loaded by NetProxy from its own folder, so everything it needs is copied next to it. -->
		<CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
		<GenerateDependencyFile>true</GenerateDependencyFile>
	</PropertyGroup>

	<ItemGroup>
		<!-- Inside this repository the plug-in API is a project reference. Private: the service supplies the plug-in API, so it must not be copied next to the plug-in. -->
		<ProjectReference Include="..\..\NetProxy.PluginApi\NetProxy.PluginApi.csproj">
			<Private>false</Private>
			<ExcludeAssets>runtime</ExcludeAssets>
		</ProjectReference>
		<ProjectReference Include="..\Common\NetProxy.Plugins.Common.csproj" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="MaxMind.Db" Version="5.2.0" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="NetProxy.Plugins.Tests" />
	</ItemGroup>

</Project>
