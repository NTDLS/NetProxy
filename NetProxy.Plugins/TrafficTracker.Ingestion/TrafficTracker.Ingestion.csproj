<Project Sdk="Microsoft.NET.Sdk.Worker">

	<PropertyGroup>
		<Version>1.0.0</Version>
		<OutputType>Exe</OutputType>
		<Description>Subscribes to the NetProxy traffic queue and writes what the traffic tracker plug-in saw to a normalized SQL Server database.</Description>
		<AssemblyName>NetProxy.TrafficTracker.Ingestion</AssemblyName>
		<RootNamespace>NetProxy.TrafficTracker.Ingestion</RootNamespace>
		<UserSecretsId>NetProxy.TrafficTracker.Ingestion</UserSecretsId>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Dapper" Version="2.1.89" />
		<PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.1" />
		<PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.14" />
		<PackageReference Include="Microsoft.Extensions.Hosting.Systemd" Version="10.0.14" />
		<PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.14" />
		<PackageReference Include="NTDLS.CatMQ.Client" Version="2.9.0" />
		<PackageReference Include="Serilog.Extensions.Hosting" Version="10.0.0" />
		<PackageReference Include="Serilog.Settings.Configuration" Version="10.0.1" />
		<PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
		<PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />

		<!-- A newer version than the one that the message queue client asks for, which has known vulnerabilities. -->
		<PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\TrafficTracker.Contracts\TrafficTracker.Contracts.csproj" />
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Include="Database\Scripts\*.sql" />
	</ItemGroup>

	<ItemGroup>
		<None Update="appsettings.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="NetProxy.TrafficTracker.Tests" />
	</ItemGroup>

	<ItemGroup>
		<Folder Include="Logs\" />
	</ItemGroup>

</Project>
