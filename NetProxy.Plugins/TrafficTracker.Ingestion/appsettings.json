{
  "ConnectionStrings": {
    "Traffic": "Server=Sql01;Database=NetProxyTraffic;Integrated Security=True;TrustServerCertificate=True;Application Name=NetProxy.TrafficTracker.Ingestion;"
  },
  "Mq": {
    "Host": "Proxy01",
    "Port": 45784,
    "Queue": "NetProxy.Traffic"
  },
  "Ingestion": {
    "CreateDatabaseIfMissing": false,
    "RetentionDays": 0,
    "PurgeBatchSize": 10000
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/ingestion-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14
        }
      }
    ]
  }
}
