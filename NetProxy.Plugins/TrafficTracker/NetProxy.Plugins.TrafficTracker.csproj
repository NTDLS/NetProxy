<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<Version>1.0.0</Version>
		<Description>A NetProxy plug-in that tracks the web traffic that passes through a proxy: host, client, user agent and more, sent to a CatMQ queue.</Description>

		<!-- The plug-in is loaded by NetProxy from its own folder, so everything it needs is copied next to it. -->
		<CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
		<GenerateDependencyFile>true</GenerateDependencyFile>
	</PropertyGroup>

	<ItemGroup>
		<!-- The service supplies the plug-in API, so it is built against and is not shipped with the plug-in (not in the output, and not published). -->
		<PackageReference Include="NetProxy.PluginApi" Version="3.2.0" />
		<PackageReference Include="NTDLS.CatMQ.Client" Version="2.9.0" />

		<!-- A newer version than the one that the message queue client asks for, which has known vulnerabilities. -->
		<PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
	</ItemGroup>

	<ItemGroup>
		<!-- The messages and the queue that this plug-in and the ingestion service share are in Common/TrafficTracker. -->
		<ProjectReference Include="..\Common\NetProxy.Plugins.Common.csproj" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="NetProxy.Plugins.Tests" />
	</ItemGroup>

	<ItemGroup>
	  <None Update="README.md">
	    <CopyToOutputDirectory>Always</CopyToOutputDirectory>
	  </None>
	</ItemGroup>

</Project>
