<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<Version>3.2.0</Version>
	</PropertyGroup>

	<ItemGroup>
		<!-- Inside this repository the plug-in API is a project reference. Outside it, a plug-in references the NetProxy.PluginApi NuGet package instead, which
		     leaves the API assembly out of the output by itself. Private: the service supplies the plug-in API, so it must not be copied next to the plug-in. -->
		<ProjectReference Include="..\NetProxy.PluginApi\NetProxy.PluginApi.csproj">
			<Private>false</Private>
			<ExcludeAssets>runtime</ExcludeAssets>
		</ProjectReference>
	</ItemGroup>

</Project>
